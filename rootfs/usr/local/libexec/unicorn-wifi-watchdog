#!/usr/bin/env bash
FAILS=0
while true; do
    GW=$(ip route show default dev wlan0 2>/dev/null | awk '{print $3; exit}')
    if [ -n "$GW" ] && ping -c 1 -W 3 -I wlan0 "$GW" >/dev/null 2>&1; then
        FAILS=0
    else
        FAILS=$((FAILS + 1))
        if [ "$FAILS" -ge 3 ]; then
            logger -t unicorn-wifi-watchdog "wlan0 unreachable (gw=${GW:-none}), cycling NetworkManager wlan0..."
            nmcli dev connect wlan0 >/dev/null 2>&1 || true
            if [ "$FAILS" -ge 6 ]; then
                nmcli radio wifi off >/dev/null 2>&1 || true
                sleep 2
                nmcli radio wifi on >/dev/null 2>&1 || true
                sleep 5
                nmcli dev connect wlan0 >/dev/null 2>&1 || true
                FAILS=0
            fi
        fi
    fi
    sleep 30
done
