 #define WLS_BOOST_EN			6
 
 #define BATTMGR_CHG_CTRL_LIMIT_EN	0x48
+
+/* Unsolicited vendor status broadcast of the Xiaomi charger firmware */
+#define BATTMGR_XIAOMI_STATUS		0x50
 #define CHARGE_CTRL_START_THR_MIN	50
 #define CHARGE_CTRL_START_THR_MAX	95
 #define CHARGE_CTRL_END_THR_MIN		55
@@ -275,6 +279,7 @@ struct qcom_battmgr_status {
 	unsigned int capacity;
 	unsigned int percent;
 	int current_now;
+	int constant_charge_current;
 	int power_now;
 	unsigned int voltage_now;
 	unsigned int voltage_ocv;
@@ -313,6 +318,11 @@ struct qcom_battmgr {
 	struct pmic_glink_client *client;
 
 	enum qcom_battmgr_variant variant;
+	/*
+	 * Some firmware still has BATT_CONSTANT_CURRENT at index 12, which
+	 * moves every later battery property up by one.
+	 */
+	bool bat_prop_constant_current;
 
 	struct power_supply *ac_psy;
 	struct power_supply *bat_psy;
@@ -361,9 +371,44 @@ static int qcom_battmgr_request(struct qcom_battmgr *battmgr, void *data, size_t
 	return battmgr->error;
 }
 
+#define BATT_FW_CONSTANT_CURRENT	12
+
+static int qcom_battmgr_bat_prop_to_fw(struct qcom_battmgr *battmgr, int property)
+{
+	if (battmgr->bat_prop_constant_current &&
+	    property >= BATT_FW_CONSTANT_CURRENT)
+		return property + 1;
+	return property;
+}
+
+static int qcom_battmgr_bat_prop_from_fw(struct qcom_battmgr *battmgr, int property)
+{
+	if (battmgr->bat_prop_constant_current &&
+	    property > BATT_FW_CONSTANT_CURRENT)
+		return property - 1;
+	return property;
+}
+
+static int qcom_battmgr_request_property_raw(struct qcom_battmgr *battmgr, int opcode,
+					     int property, u32 value)
+{
+	struct qcom_battmgr_property_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(opcode),
+		.property = cpu_to_le32(property),
+		.value = cpu_to_le32(value),
+	};
+
+	return qcom_battmgr_request(battmgr, &request, sizeof(request));
+}
+
 static int qcom_battmgr_request_property(struct qcom_battmgr *battmgr, int opcode,
 					 int property, u32 value)
 {
+	if (opcode == BATTMGR_BAT_PROPERTY_GET || opcode == BATTMGR_BAT_PROPERTY_SET)
+		property = qcom_battmgr_bat_prop_to_fw(battmgr, property);
+
 	struct qcom_battmgr_property_request request = {
 		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
 		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
@@ -458,6 +503,15 @@ static int qcom_battmgr_bat_sm8350_update(struct qcom_battmgr *battmgr,
 	unsigned int prop;
 	int ret;
 
+	if (psp == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT &&
+	    battmgr->bat_prop_constant_current) {
+		mutex_lock(&battmgr->lock);
+		ret = qcom_battmgr_request_property_raw(battmgr, BATTMGR_BAT_PROPERTY_GET,
+							BATT_FW_CONSTANT_CURRENT, 0);
+		mutex_unlock(&battmgr->lock);
+		return ret;
+	}
+
 	if (psp >= ARRAY_SIZE(sm8350_bat_prop_map))
 		return -EINVAL;
 
@@ -562,6 +616,9 @@ static int qcom_battmgr_bat_get_property(struct power_supply *psy,
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
 		val->intval = battmgr->status.current_now;
 		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		val->intval = battmgr->status.constant_charge_current;
+		break;
 	case POWER_SUPPLY_PROP_POWER_NOW:
 		val->intval = battmgr->status.power_now;
 		break;
@@ -763,6 +820,7 @@ static int qcom_battmgr_bat_is_writeable(struct power_supply *psy,
 	switch (psp) {
 	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
 	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
 		return 1;
 	default:
 		return 0;
@@ -785,6 +843,16 @@ static int qcom_battmgr_bat_set_property(struct power_supply *psy,
 		return qcom_battmgr_set_charge_start_threshold(battmgr, pval->intval);
 	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
 		return qcom_battmgr_set_charge_end_threshold(battmgr, pval->intval);
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT: {
+		int ret;
+		mutex_lock(&battmgr->lock);
+		ret = qcom_battmgr_request_property_raw(battmgr, BATTMGR_BAT_PROPERTY_SET,
+							BATT_FW_CONSTANT_CURRENT, pval->intval);
+		mutex_unlock(&battmgr->lock);
+		if (!ret)
+			battmgr->status.constant_charge_current = pval->intval;
+		return ret;
+	}
 	default:
 		return -EINVAL;
 	}
@@ -885,6 +953,7 @@ static const enum power_supply_property sm8350_bat_props[] = {
 	POWER_SUPPLY_PROP_INTERNAL_RESISTANCE,
 	POWER_SUPPLY_PROP_STATE_OF_HEALTH,
 	POWER_SUPPLY_PROP_POWER_NOW,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
 };
 
 static const struct power_supply_desc sm8350_bat_psy_desc = {
@@ -893,6 +962,8 @@ static const struct power_supply_desc sm8350_bat_psy_desc = {
 	.properties = sm8350_bat_props,
 	.num_properties = ARRAY_SIZE(sm8350_bat_props),
 	.get_property = qcom_battmgr_bat_get_property,
+	.set_property = qcom_battmgr_bat_set_property,
+	.property_is_writeable = qcom_battmgr_bat_is_writeable,
 };
 
 static const enum power_supply_property sm8550_bat_props[] = {
@@ -1217,6 +1288,9 @@ static void qcom_battmgr_notification(struct qcom_battmgr *battmgr,
 	case NOTIF_WLS_PROPERTY:
 		power_supply_changed(battmgr->wls_psy);
 		break;
+	case BATTMGR_XIAOMI_STATUS:
+		/* Xiaomi vendor properties changed; none of them are exported */
+		break;
 	default:
 		dev_err(battmgr->dev, "unknown notification: %#x\n", notification);
 		break;
@@ -1380,8 +1454,17 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 	}
 
 	switch (opcode) {
+	case BATTMGR_BAT_PROPERTY_SET:
+	case BATTMGR_USB_PROPERTY_SET:
+		break;
 	case BATTMGR_BAT_PROPERTY_GET:
-		property = le32_to_cpu(resp->intval.property);
+		if (battmgr->bat_prop_constant_current &&
+		    le32_to_cpu(resp->intval.property) == BATT_FW_CONSTANT_CURRENT) {
+			battmgr->status.constant_charge_current = le32_to_cpu(resp->intval.value);
+			break;
+		}
+		property = qcom_battmgr_bat_prop_from_fw(battmgr,
+				le32_to_cpu(resp->intval.property));
 		if (property == BATT_MODEL_NAME) {
 			if (payload_len != sizeof(resp->strval)) {
 				dev_warn(battmgr->dev,
@@ -1433,7 +1516,12 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 			battmgr->info.voltage_max = le32_to_cpu(resp->intval.value);
 			break;
 		case BATT_CURR_NOW:
-			battmgr->status.current_now = le32_to_cpu(resp->intval.value);
+			/*
+			 * The firmware reports charging current as negative,
+			 * the ABI wants it positive (upower takes a negative
+			 * current as discharging, whatever the status says).
+			 */
+			battmgr->status.current_now = -(int)le32_to_cpu(resp->intval.value);
 			break;
 		case BATT_TEMP:
 			val = le32_to_cpu(resp->intval.value);
@@ -1575,6 +1663,14 @@ static void qcom_battmgr_callback(const void *data, size_t len, void *priv)
 	struct qcom_battmgr *battmgr = priv;
 	unsigned int opcode = le32_to_cpu(hdr->opcode);
 
+	/*
+	 * Xiaomi firmware broadcasts its own status block every few minutes.
+	 * It is not a reply to a request, so it must not complete the ack of
+	 * a request that is in flight.
+	 */
+	if (opcode == BATTMGR_XIAOMI_STATUS)
+		return;
+
 	if (opcode == BATTMGR_NOTIFICATION)
 		qcom_battmgr_notification(battmgr, data, len);
 	else if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
@@ -1652,6 +1748,9 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 	mutex_init(&battmgr->lock);
 	init_completion(&battmgr->ack);
 
+	/* Xiaomi 12T Pro ADSP firmware (BSP enum with BATT_CONSTANT_CURRENT) */
+	battmgr->bat_prop_constant_current = (of_machine_is_compatible("xiaomi,diting") || of_machine_is_compatible("xiaomi,unicorn"));
+
 	match = of_match_device(qcom_battmgr_of_variants, dev->parent);
 	if (match)
 		battmgr->variant = (unsigned long)match->data;
